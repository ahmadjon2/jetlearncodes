import pandas as pd

data = pd.read_csv("movies_metadata.csv")
#print(data.info())

from sklearn.feature_extraction.text import TfidfVectorizer
tfid = TfidfVectorizer(stop_words="english")
data["overview"] = data["overview"].fillna("")
tfid_matrix = tfid.fit_transform(data["overview"])
print(tfid_matrix.shape)
print(tfid_matrix)
print(tfid.get_feature_names_out()[5000:5010])
from sklearn.metrics.pairwise import linear_kernel
lk = linear_kernel(tfid_matrix,tfid_matrix)
cosine_similarity = lk
indices = pd.Series(data.index, index = data["title"]).drop_duplicates()
def get_recommendation(title):
    idx = indices["title"]
    similarity_scores = list(enumerate(cosine_similarity[idx]))
    sortedlist = sorted(similarity_scores,key=lambda x:x[1],reverse=True)
    similarity_scores = similarity_scores[1:11]
    movies_indices = [i[0] for i in similarity_scores]
    return data["title"].iloc[movies_indices]
get_recommendation("The Dark Knight Rises")

